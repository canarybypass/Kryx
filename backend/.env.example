OPENROUTER_API_KEY=your_openrouter_key_here
ANTHROPIC_API_KEY=your_anthropic_key_here
OPENAI_API_KEY=your_openai_key_here

# Tool integrations
SHODAN_API_KEY=your_shodan_key_here
CENSYS_API_ID=your_censys_id_here
CENSYS_API_SECRET=your_censys_secret_here

# Metasploit RPC (run: msfrpcd -P msfrpc -S -a 127.0.0.1)
MSFRPC_HOST=127.0.0.1
MSFRPC_PORT=55553
MSFRPC_PASS=msfrpc

# Auth
SECRET_KEY=change-me-to-random-32-char-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# DB (overridden by docker-compose)
DATABASE_URL=postgresql+asyncpg://hexor:hexor@localhost:5432/hexor

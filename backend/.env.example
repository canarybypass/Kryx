OPENROUTER_API_KEY=your_openrouter_key_here
ANTHROPIC_API_KEY=your_anthropic_key_here
OPENAI_API_KEY=your_openai_key_here

# Tool integrations
SHODAN_API_KEY=your_shodan_key_here
CENSYS_API_ID=your_censys_id_here
CENSYS_API_SECRET=your_censys_secret_here

# Metasploit RPC (run: msfrpcd -P msfrpc -S -a 127.0.0.1)
MSFRPC_HOST=127.0.0.1
MSFRPC_PORT=55553
MSFRPC_PASS=msfrpc

# Auth
SECRET_KEY=change-me-to-random-32-char-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# DB (overridden by docker-compose)
DATABASE_URL=postgresql+asyncpg://vulnyx:vulnyx@localhost:5432/vulnyx

# Stripe Billing
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_STARTER=price_... # $99/mo
STRIPE_PRICE_PRO=price_...     # $499/mo
STRIPE_PRICE_ENTERPRISE=price_... # $2999/mo
STRIPE_PRICE_APT=price_...     # $9999/mo

# Frontend URL (for Stripe redirect)
FRONTEND_URL=http://localhost:3000
